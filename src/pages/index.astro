---
import Layout from '../layouts/main.astro';
import { Hero } from '@/components/Hero';
import { Problem } from '@/components/Problem';
import { Solution } from '@/components/Solution';
import { PiTeaser } from '@/components/PiTeaser';
import { EcosystemLaunch } from '@/components/EcosystemLaunch';
import { Social } from '@/components/Social';
import { WhyGraphs } from '@/components/WhyGraphs';
import { Ethos } from '@/components/Ethos';
import { Team } from '@/components/Team';
import { Brands } from '@/components/Brands';
import { Backers } from '@/components/Backers';
import { Resources } from '@/components/Resources';
import { TGE } from '@/components/TGE';
import { GetInTouch } from '@/components/GetInTouch';
import { StickyWaitlistCta } from '@/components/StickyWaitlistCta';

const title = 'ASIMOV Systems | Context-graph AI, PI & Protocol';
const description =
  'ASIMOV Systems: a small team building context-graph-based Personal Intelligence and open protocol infrastructure. Early access for ASIMOV PI at live events. Explore the Protocol ecosystem.';
const canonicalUrl = 'https://asimov.systems/';
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://asimov.systems/og-image.png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://asimov.systems/og-image.png" />
    <meta name="twitter:image:alt" content="ASIMOV Systems | Context-graph AI, PI & Protocol" />
    <meta name="twitter:site" content="@ASIMOV_Protocol" />
  </Fragment>

  <Hero client:load />
  <Problem />
  <Solution />
  <WhyGraphs />
  <PiTeaser />
  <EcosystemLaunch />
  <Social />
  <Ethos client:load />
  <Team />
  <Backers client:load />
  <Brands client:load />
  <Resources />
  <TGE />
  <GetInTouch />
  <StickyWaitlistCta client:load />
</Layout>
