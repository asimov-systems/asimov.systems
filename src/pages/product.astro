---
import Layout from '@/layouts/main.astro';
import { idJoinWaitlistUrl } from '@/lib/consts';

const eventFeatures = [
  {
    title: "Let's Connect",
    body: 'Selfie connect at events: instantly link a face to your relationship graph with full context.'
  },
  {
    title: 'Scan the Room',
    body: "Camera context retrieval. Discover who's in the room and what you should know before you approach."
  },
  {
    title: 'Who introduced me?',
    body: 'Trace introductions and history across your network, not scattered across apps.'
  },
  {
    title: 'What did we discuss?',
    body: "Last meet, next person to speak to, which event they'll attend. Ask your graph, not your memory."
  }
];

const experiencePillars = [
  {
    title: 'Relationship graph you own',
    body: 'Context graphs, not black-box prediction. Local-first, privacy by design.'
  },
  {
    title: 'Live event networking',
    body: "Where we're focusing first: conferences and meetups, with a mobile prototype built for real rooms."
  },
  {
    title: 'Credit economy',
    body: 'Introductions and connections earn credits today. A ledger that informs token economics when the network is ready.'
  },
  {
    title: 'Intelligence on your terms',
    body: 'Who introduced you, what you discussed, who to meet next, and where your network will be.'
  }
];

/** Set href when real YouTube URLs are approved for publish. */
const communityReactions = [
  { title: 'Event reaction', href: null as string | null, label: 'YouTube' },
  { title: 'User walkthrough', href: null, label: 'YouTube' },
  { title: 'Conference demo', href: null, label: 'YouTube' }
];

const title = 'ASIMOV PI | Personal Intelligence at live events';
const description =
  'ASIMOV PI: relationship graph ownership at conferences and events. Selfie connect, scan the room, context retrieval. Join early access.';
const canonicalUrl = 'https://asimov.systems/product';
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://asimov.systems/og-image.png" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://asimov.systems/og-image.png" />
    <meta name="twitter:site" content="@ASIMOV_Protocol" />
  </Fragment>

  <section class="py-20 lg:py-32">
    <div class="container mx-auto px-4 lg:px-6">
      <p
        class="text-muted-foreground mx-auto max-w-3xl text-center text-sm font-semibold tracking-wide uppercase"
      >
        ASIMOV PI only
      </p>
      <header class="mx-auto max-w-3xl text-center">
        <h1 class="font-calSans mt-2 text-3xl font-bold md:text-4xl lg:text-5xl">
          Personal Intelligence at live events
        </h1>
        <p class="text-foreground mt-4 text-lg">
          Own your relationship graph where networks actually form: conferences, meetups, and rooms
          full of people you should remember. Protocol and marketplace context live on{' '}
          <a href="/build" class="text-primary font-medium hover:underline">Build on ASIMOV</a> and{
            ' '
          }
          <a href="/" class="text-primary font-medium hover:underline">the company home</a>.
        </p>
      </header>

      <div
        class="border-border bg-card/50 mx-auto mt-16 max-w-3xl rounded-xl border p-6 text-center md:p-10"
      >
        <h2 class="text-xl font-semibold md:text-2xl">The wow moment</h2>
        <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-base leading-relaxed">
          Selfie connect links a face to your graph in seconds. Scan the room pulls camera context
          before you approach someone. Ask your graph who introduced you, what you last discussed,
          and who to speak to next. That is the prototype we are validating invite-only at events.
        </p>
      </div>

      <div class="mx-auto mt-16 max-w-3xl">
        <h2 class="text-center text-2xl font-semibold md:text-3xl">Event networking prototype</h2>
        <p class="text-muted-foreground mt-3 text-center text-sm">
          Invite-only early access. Validating at conferences and meetups.
        </p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {
            eventFeatures.map((feature) => (
              <div class="border-border rounded-lg border p-6">
                <h3 class="font-semibold">{feature.title}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{feature.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mx-auto mt-20 max-w-5xl">
        <h2 class="text-center text-2xl font-semibold md:text-3xl">Built for the real world</h2>
        <p class="text-muted-foreground mx-auto mt-3 max-w-2xl text-center text-base">
          Context graphs with verifiable provenance, not statistical guesswork.
        </p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {
            experiencePillars.map((pillar) => (
              <div class="border-border rounded-lg border p-6">
                <h3 class="font-semibold">{pillar.title}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{pillar.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mx-auto mt-20 max-w-4xl">
        <h2 class="text-center text-2xl font-semibold md:text-3xl">Reactions from the room</h2>
        <p class="text-muted-foreground mx-auto mt-3 max-w-2xl text-center text-sm">
          Short clips from users and events. URLs below are placeholders until final videos are
          approved for publish.
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            communityReactions.map((item) => (
              <li class="border-border rounded-lg border p-5">
                {item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary font-medium hover:underline"
                  >
                    {item.title}
                  </a>
                ) : (
                  <span class="text-foreground font-medium">{item.title}</span>
                )}
                <p class="text-muted-foreground mt-2 text-xs">{item.label} · URL pending</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="border-border bg-card/50 mx-auto mt-16 max-w-3xl rounded-xl border p-6 text-center md:p-10"
      >
        <h2 class="text-xl font-semibold">Beyond events</h2>
        <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-base">
          Email, chat, CRM, and notes will connect into your graph over time. Today we start in the
          room.
        </p>
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-4">
        <a
          href={idJoinWaitlistUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center justify-center rounded-md px-6 text-sm font-medium"
        >
          Join early access
        </a>
        <a
          href="/how-it-works"
          class="border-input bg-background hover:bg-accent inline-flex h-10 items-center justify-center rounded-md border px-6 text-sm font-medium"
        >
          How it works
        </a>
        <a
          href="/investors"
          class="border-input bg-background hover:bg-accent inline-flex h-10 items-center justify-center rounded-md border px-6 text-sm font-medium"
        >
          For investors
        </a>
      </div>
    </div>
  </section>
</Layout>
