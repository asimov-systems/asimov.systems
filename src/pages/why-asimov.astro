---
import Layout from '@/layouts/main.astro';
import { idJoinWaitlistUrl } from '@/lib/consts';

const title = 'Why ASIMOV - Context graphs & privacy | ASIMOV Systems';
const description =
  'Context graphs, not prediction. Verifiable provenance, local-first privacy. How ASIMOV PI builds your relationship graph without exposing private data.';
const canonicalUrl = 'https://asimov.systems/why-asimov';
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://asimov.systems/og-image.png" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ASIMOV_Protocol" />
  </Fragment>

  <section class="py-20 lg:py-32">
    <div class="container mx-auto px-4 lg:px-6">
      <header class="mx-auto max-w-3xl text-center">
        <p class="text-muted-foreground text-sm font-semibold tracking-wide uppercase">
          Why ASIMOV
        </p>
        <h1 class="font-calSans mt-2 text-3xl font-bold md:text-4xl lg:text-5xl">
          Context graphs. Verifiable provenance. Privacy by design.
        </h1>
        <p class="text-muted-foreground mt-4 text-lg">
          We go beyond statistical prediction to structured context graphs: your relationship
          network, linked with intelligence you can trace. Local-first architecture keeps your graph
          under your control while the Protocol powers shared, verifiable public knowledge.
        </p>
      </header>

      <figure class="border-border bg-card/50 mx-auto mt-12 max-w-4xl rounded-xl border p-4 md:p-6">
        <img
          src="/assets/AsimovPIdatadiagram.png"
          alt="ASIMOV PI architecture: public data sources and ingestion pipeline to cloud cache; your personal cache (private data) combined and linked into your Personal Context Graph; ASIMOV Intelligence Tools output."
          class="w-full rounded-lg"
          width="1200"
          height="800"
        />
        <figcaption class="text-muted-foreground mt-3 text-center text-sm">
          Public and personal storage, combined and linked into your Personal Context Graph,
          powering ASIMOV Intelligence Tools.
        </figcaption>
      </figure>

      <div
        class="border-border bg-card/50 mx-auto mt-16 max-w-3xl space-y-12 rounded-xl border p-6 md:p-10"
      >
        <div>
          <h2 class="text-lg font-semibold">1. Public knowledge layer</h2>
          <p class="text-muted-foreground mt-2 max-w-3xl text-base">
            Public data sources (websites, social networks, public APIs, news and events) feed into
            an ingestion pipeline. That pipeline fills the ASIMOV Cloud Cache, a shared public
            storage layer. Everyone benefits from the same useful context (e.g. identity
            recognition, public knowledge).
          </p>
        </div>
        <div>
          <h2 class="text-lg font-semibold">2. Your relationship graph</h2>
          <p class="text-muted-foreground mt-2 max-w-3xl text-base">
            When you sign up, we create your personal storage: the ASIMOV Personal Cache. It is
            physically separate from public storage. Your contacts, meetings, and private context
            live here. Local-first, privacy by design.
          </p>
        </div>
        <div>
          <h2 class="text-lg font-semibold">3. Personal Context Graph</h2>
          <p class="text-muted-foreground mt-2 max-w-3xl text-base">
            The system links public cache and your personal cache (without mixing underlying
            stores). That produces your Personal Context Graph: who introduced you, what you
            discussed, who to meet next, and where they&apos;ll be.
          </p>
        </div>
        <div>
          <h2 class="text-lg font-semibold">4. ASIMOV PI tools</h2>
          <p class="text-muted-foreground mt-2 max-w-3xl text-base">
            Smart search, event networking, camera context retrieval, and relationship intelligence
            run on your graph. Inferential connections enrich your network without exposing private
            data to the shared layer.
          </p>
        </div>
      </div>

      <p class="text-muted-foreground mx-auto mt-10 max-w-3xl text-center text-base italic">
        Vision unchanged: a decentralized marketplace for structured, verifiable knowledge, where
        intelligence belongs to the individual. PI is how we get there; real usage builds the
        marketplace.
      </p>

      <div class="mt-16 flex flex-wrap justify-center gap-4">
        <a
          href="/product"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center justify-center rounded-md px-6 text-sm font-medium"
        >
          Explore ASIMOV PI
        </a>
        <a
          href={idJoinWaitlistUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border-input bg-background hover:bg-accent inline-flex h-10 items-center justify-center rounded-md border px-6 text-sm font-medium"
        >
          Join waitlist
        </a>
        <a
          href="/investors"
          class="border-input bg-background hover:bg-accent inline-flex h-10 items-center justify-center rounded-md border px-6 text-sm font-medium"
        >
          For investors →
        </a>
      </div>
    </div>
  </section>
</Layout>
